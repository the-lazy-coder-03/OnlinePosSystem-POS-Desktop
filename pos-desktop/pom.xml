<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>za.co.onlinepos</groupId>
    <artifactId>pos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>pos-desktop</artifactId>
  <dependencies>
    <dependency><groupId>org.jboss.weld.se</groupId><artifactId>weld-se-core</artifactId></dependency>
    <dependency><groupId>za.co.onlinepos</groupId><artifactId>pos-installation</artifactId><version>${project.version}</version></dependency>
    <dependency>
      <groupId>za.co.onlinepos</groupId>
      <artifactId>pos-contracts</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>za.co.onlinepos</groupId>
      <artifactId>pos-emergency</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>za.co.onlinepos</groupId>
      <artifactId>pos-printing</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
    </dependency>
  </dependencies>
  <properties>
    <desktop.args/>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <configuration>
          <mainClass>za.co.onlinepos.desktop.Launcher</mainClass>
          <commandlineArgs>${desktop.args}</commandlineArgs>
          <options>
            <option>--enable-native-access=javafx.graphics</option>
          </options>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
